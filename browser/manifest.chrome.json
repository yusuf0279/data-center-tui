{
  "manifest_version": 3,
  "name": "My Data Center",
  "version": "0.1.0",
  "description": "A pixel-art idle tycoon. Buy servers, hire Vibecoders, survive crises and open ever-bigger data centers.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Play My Data Center",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"]
}
